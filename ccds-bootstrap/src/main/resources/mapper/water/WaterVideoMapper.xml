<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ccds.water.water.mapper.WaterVideoMapper">

    <resultMap id="WaterVideoResultMap" type="com.ccds.water.water.entity.WaterVideoDO">
        <id column="id" property="id"/>
        <result column="station_id" property="stationId"/>
        <result column="water_id" property="waterId"/>
        <result column="file_id" property="fileId"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="frame_file_ids" property="frameFileIds"/>
        <result column="check_status" property="checkStatus"/>
        <result column="check_reason" property="checkReason"/>
        <result column="client_reported" property="clientReported"/>
        <result column="created_by" property="createdBy"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <sql id="WaterVideoColumns">
        id, station_id, water_id, file_id, duration_ms, frame_file_ids, check_status,
        check_reason, client_reported, created_by, gmt_create, gmt_modified
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ccds_water_video
            (station_id, water_id, file_id, duration_ms, frame_file_ids, check_status,
             check_reason, client_reported, created_by)
        VALUES
            (#{stationId}, #{waterId}, #{fileId}, #{durationMs}, #{frameFileIds}, #{checkStatus},
             #{checkReason}, #{clientReported}, #{createdBy})
    </insert>

    <select id="selectByWaterId" resultMap="WaterVideoResultMap">
        SELECT
        <include refid="WaterVideoColumns"/>
        FROM ccds_water_video
        WHERE water_id = #{waterId}
        ORDER BY id DESC
    </select>

    <!-- 「上传出水视频数」只数真有视频的卡；是否在用由水源状态在 Service 层判定 -->
    <select id="countVideosByWaterIds" resultType="java.util.HashMap">
        SELECT water_id AS waterId, COUNT(*) AS cnt
        FROM ccds_water_video
        WHERE station_id IN
        <foreach collection="stationIds" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
        GROUP BY water_id
    </select>

    <delete id="deleteByWaterId">
        DELETE FROM ccds_water_video WHERE water_id = #{waterId}
    </delete>

</mapper>
