<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ccds.org.org.mapper.BrigadeMapper">

    <resultMap id="BrigadeResultMap" type="com.ccds.org.org.entity.BrigadeDO">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <sql id="BrigadeColumns">
        id, code, name, gmt_create, gmt_modified
    </sql>

    <select id="selectById" resultMap="BrigadeResultMap">
        SELECT
        <include refid="BrigadeColumns"/>
        FROM ccds_brigade
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BrigadeResultMap">
        SELECT
        <include refid="BrigadeColumns"/>
        FROM ccds_brigade
        ORDER BY id ASC
    </select>
</mapper>
