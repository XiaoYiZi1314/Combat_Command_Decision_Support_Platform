<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ccds.iam.identity.mapper.AccountSessionMapper">

    <resultMap id="AccountSessionResultMap" type="com.ccds.iam.identity.entity.AccountSessionDO">
        <id column="id" property="id"/>
        <result column="account_id" property="accountId"/>
        <result column="token_hash" property="tokenHash"/>
        <result column="expire_at" property="expireAt"/>
        <result column="device_hint" property="deviceHint"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <sql id="SessionColumns">
        id, account_id, token_hash, expire_at, device_hint, gmt_create, gmt_modified
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ccds_account_session
            (account_id, token_hash, expire_at, device_hint, gmt_create, gmt_modified)
        VALUES
            (#{accountId}, #{tokenHash}, #{expireAt}, #{deviceHint}, #{gmtCreate}, #{gmtModified})
    </insert>

    <select id="selectById" resultMap="AccountSessionResultMap">
        SELECT
        <include refid="SessionColumns"/>
        FROM ccds_account_session
        WHERE id = #{id}
    </select>

    <select id="selectByTokenHash" resultMap="AccountSessionResultMap">
        SELECT
        <include refid="SessionColumns"/>
        FROM ccds_account_session
        WHERE token_hash = #{tokenHash}
    </select>

    <update id="updateTokenHash">
        UPDATE ccds_account_session
        SET token_hash = #{tokenHash},
            expire_at = #{expireAt},
            gmt_modified = #{gmtModified}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM ccds_account_session
        WHERE id = #{id}
    </delete>

    <delete id="deleteByAccountId">
        DELETE FROM ccds_account_session
        WHERE account_id = #{accountId}
    </delete>
</mapper>
