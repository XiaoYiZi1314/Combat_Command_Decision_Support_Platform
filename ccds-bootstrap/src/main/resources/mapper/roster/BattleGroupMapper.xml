<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ccds.roster.roster.mapper.BattleGroupMapper">

    <resultMap id="BattleGroupResultMap" type="com.ccds.roster.roster.entity.BattleGroupDO">
        <id column="id" property="id"/>
        <result column="station_id" property="stationId"/>
        <result column="name" property="name"/>
        <result column="sort_no" property="sortNo"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <select id="selectByStationId" resultMap="BattleGroupResultMap">
        SELECT id, station_id, name, sort_no, gmt_create, gmt_modified
        FROM ccds_battle_group
        WHERE station_id = #{stationId}
        ORDER BY sort_no ASC, id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ccds_battle_group (station_id, name, sort_no, gmt_create, gmt_modified)
        VALUES (#{stationId}, #{name}, #{sortNo}, #{gmtCreate}, #{gmtModified})
    </insert>

    <delete id="deleteByStationId">
        DELETE FROM ccds_battle_group
        WHERE station_id = #{stationId}
    </delete>
</mapper>
