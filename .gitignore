# 默认不追踪任何文件，仅放行代码源文件
*
!*/

!.gitignore

# 项目说明、开发规范、架构决策与交付规划属于项目必要资产
!README.md
!**/README.md
!AGENTS.md
!CLAUDE.md
!CONTEXT.md
!harness/**
!docs/adr/**
!docs/agents/**
!docs/planning/**

# 后端
!*.java
!*.kt
!*.kts
!*.groovy
!*.scala

# 前端
!*.js
!*.mjs
!*.cjs
!*.jsx
!*.ts
!*.tsx
!*.vue
!*.css
!*.scss
!*.less
!*.html
!*.jsp
!*.ftl

# 映射、脚本与契约
!*.xml
!*.sql
!*.proto
!*.yml
!*.yaml
!*.json
!*.json5
!*.gradle
!*.properties
!*.pro
!*.ets
!*.svg
!*.example
!*.bat
!gradlew
!gradle-wrapper.jar

# 工具链与构建产物即使带代码扩展名也不追踪
.cursor/
.opencode/
.pi/
.github/
.idea/
.vscode/
node_modules/
target/
dist/
build/
out/
# 反编产物仅作本地参考，不入库（内含客户 APK 的真实云配置密钥）
tmp_apk/
app-h5/android-shell/local.properties
app-h5/android-shell/.gradle/
app-h5/android-shell/app/build/
app-h5/android-shell/app/src/main/assets/www/
app-h5/harmony-shell/entry/build/
app-h5/harmony-shell/oh_modules/
app-h5/harmony-shell/entry/src/main/resources/rawfile/www/