# 默认不追踪任何文件，仅放行代码源文件
*
!*/

!.gitignore

# 后端
!*.java
!*.kt
!*.kts
!*.groovy
!*.scala

# 前端
!*.js
!*.mjs
!*.cjs
!*.jsx
!*.ts
!*.tsx
!*.vue
!*.css
!*.scss
!*.less
!*.html
!*.jsp
!*.ftl

# 映射、脚本与契约
!*.xml
!*.sql
!*.proto
!*.yml
!*.yaml
!*.json
!*.json5
!*.gradle
!*.properties
!*.pro
!*.ets
!*.svg
!*.md
!*.example
!*.bat
!gradlew
!gradle-wrapper.jar

# 工具链与构建产物即使带代码扩展名也不追踪
.cursor/
.opencode/
.github/
.idea/
.vscode/
node_modules/
target/
dist/
build/
out/
app-h5/android-shell/local.properties
app-h5/android-shell/.gradle/
app-h5/android-shell/app/build/
app-h5/android-shell/app/src/main/assets/www/
app-h5/harmony-shell/entry/build/
app-h5/harmony-shell/oh_modules/
app-h5/harmony-shell/entry/src/main/resources/rawfile/www/